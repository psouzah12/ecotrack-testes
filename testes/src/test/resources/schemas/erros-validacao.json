{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Erros de validação, um por campo",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["campo", "mensagem"],
    "additionalProperties": false,
    "properties": {
      "campo": { "$ref": "comum.json#/$defs/texto" },
      "mensagem": { "$ref": "comum.json#/$defs/texto" }
    }
  }
}
